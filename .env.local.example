# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://nucawzoaxpqenhwpirpm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_.
# Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Capture (photo/PDF → shifts or staff sheet) ─────────────────────────────
# Required for the Capture/Upload/Upload PDF buttons on Shifts and Staff.
# console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# ─── SMS mode (the master safety switch) ─────────────────────────────────────
# console  — nothing is sent anywhere. Messages are logged and you can simulate
#            replies in the UI. No Twilio account needed. Start here.
# redirect — really sent via Twilio, but EVERY recipient is rewritten to
#            SMS_TEST_NUMBER and the body is prefixed with who it was for.
# live     — sent to real staff mobiles.
SMS_MODE=console

# Where redirect mode sends everything.
SMS_TEST_NUMBER=+61491570156

# Hard ceiling, enforced in EVERY mode including live. While this is set, no
# message can reach a number outside it. Clear it only when going live.
SMS_ALLOWLIST=+61491570156

# ─── Twilio (not needed while SMS_MODE=console) ──────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Must be an Australian MOBILE number (+614…). Australian local/landline
# numbers (+612, +618…) cannot send or receive SMS.
TWILIO_FROM_NUMBER=+614XXXXXXXX

# Must match byte-for-byte the URL Twilio calls — it is what the request
# signature is computed over. Set per environment.
TWILIO_WEBHOOK_URL=https://your-app.vercel.app/api/sms/inbound

# ─── Behaviour ───────────────────────────────────────────────────────────────
APP_TIMEZONE=Australia/Perth
CLAIM_RACE_EXPIRY_MINUTES=60
SMS_MAX_RECIPIENTS=25
SMS_QUIET_HOURS=21:00-07:00
SMS_BUSINESS_NAME=Farmer Jack's

# Optional: locks the reply simulator on preview deploys.
SMS_SIMULATE_TOKEN=

# ─── Automation (unattended roster import, e.g. the Humanforce PDF scrape) ───
# Required for POST /api/automation/roster-pdf. This is a bearer token, not a
# manager login — there's no browser session on the calling end, just a
# script. Generate a long random value (e.g. `openssl rand -hex 32`) and set
# it identically here and wherever the automation script runs (e.g. a GitHub
# Actions secret). Leaving it unset disables the endpoint entirely.
AUTOMATION_TOKEN=
