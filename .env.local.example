# Must match the Supabase project this deployment uses — set the same values
# in the hosting provider's environment variables, not just here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Needed only for the Capture button, which reads a photo of the availability
# sheet. Without it the app still runs; Capture reports that it is not set up.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional override for the model that reads the photo. The default is
# claude-sonnet-5, which is quick enough to finish inside the hosting platform's
# 60-second function limit. claude-opus-5 reads a creased or dim photo more
# accurately and switches on fast mode automatically, but is likelier to run out
# of time on a long sheet.
# ANTHROPIC_MODEL=claude-opus-5
