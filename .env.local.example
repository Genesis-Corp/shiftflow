# Must match the Supabase project this deployment uses — set the same values
# in the hosting provider's environment variables, not just here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Needed only for the Capture button, which reads a photo of the availability
# sheet. Without it the app still runs; Capture reports that it is not set up.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional override for the model that reads the photo. The default is
# claude-opus-5, run at low effort in fast mode to stay inside the hosting
# platform's 60-second function limit. If reads still time out, claude-sonnet-5
# is quicker.
# ANTHROPIC_MODEL=claude-opus-5
